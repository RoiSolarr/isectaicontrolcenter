# ------------------------------------------------------------------
# iSectAI Control Center — environment variables
# Copy this file to `.env.local` and fill in your own values.
# ------------------------------------------------------------------

# Supabase → Project Settings → API
# (use the anon / publishable key — NEVER the service_role key in a NEXT_PUBLIC_ variable)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Running Supabase locally with the CLI instead? Use the values printed by
# `npm run db:start` (or `npx supabase status`):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from supabase status>

# Optional: where the "Forgot password?" link on the login page sends staff.
NEXT_PUBLIC_SUPPORT_EMAIL=it-support@example.com
